# syntax=docker/dockerfile:1
FROM node:22-alpine
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npx prisma generate --schema src/database/prisma/schema.prisma
CMD ["sh", "-c", "npx prisma migrate dev --schema src/database/prisma/schema.prisma --name init && npx nest start --watch"]